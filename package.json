{
  "name": "etsy-posters",
  "version": "1.0.0",
  "description": "Monorepo: TypeScript poster generator + Python Etsy research pipeline.",
  "private": true,
  "workspaces": [
    "apps/generator"
  ],
  "scripts": {
    "dev": "npm run dev -w @etsy-posters/generator",
    "ui": "npm run ui -w @etsy-posters/generator",
    "build": "npm run build -w @etsy-posters/generator",
    "start": "npm run start -w @etsy-posters/generator",
    "research": "node scripts/research.cjs",
    "research:collect": "node scripts/research.cjs collect",
    "research:analyze": "node scripts/research.cjs analyze",
    "research:prompt": "node scripts/research.cjs prompt",
    "research:generate": "node scripts/research.cjs generate",
    "research:all": "node scripts/research.cjs run-all"
  },
  "engines": {
    "node": ">=18"
  }
}
