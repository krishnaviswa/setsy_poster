{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etsy-posters.local/contracts/niche.schema.json",
  "title": "Niche",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "label",
    "style",
    "audience",
    "etsySearchPhrase",
    "buyerIntent",
    "riskNotes",
    "defaultSubjects",
    "suggestedColors"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "label": { "type": "string" },
    "style": { "type": "string" },
    "audience": { "type": "string" },
    "etsySearchPhrase": { "type": "string" },
    "buyerIntent": { "type": "string" },
    "riskNotes": { "type": "string" },
    "defaultSubjects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "suggestedColors": { "type": "string" }
  }
}
