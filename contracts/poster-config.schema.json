{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etsy-posters.local/contracts/poster-config.schema.json",
  "title": "PosterConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "theme",
    "count",
    "style",
    "colors",
    "composition",
    "subjects",
    "widthInches",
    "heightInches",
    "dpi"
  ],
  "properties": {
    "theme": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 1, "maximum": 4 },
    "style": { "type": "string", "minLength": 1 },
    "colors": { "type": "string", "minLength": 1 },
    "composition": { "type": "string", "minLength": 1 },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "widthInches": { "type": "number", "exclusiveMinimum": 0 },
    "heightInches": { "type": "number", "exclusiveMinimum": 0 },
    "dpi": { "type": "integer", "minimum": 72 },
    "creativeBrief": { "type": "string" }
  }
}
